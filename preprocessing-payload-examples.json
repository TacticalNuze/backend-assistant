  "important_notes": [
    "Files must be uploaded to MinIO before running preprocessing:",
    "  - Bucket name: {client_id}",
    "  - Object prefix: {project_id}/",
    "  - Example: 'dpac/dpac_portal_test_1/document.pdf'",
    "",
    "The 'language' field automatically injects 'domain_id' based on the value:",
    "  - 'en' -> 'en_dpac'",
    "  - 'it' -> 'it_dpac'",
    "  - 'fr' -> 'fr_dpac'",
    "",
    "Supported file formats: PDF, TXT, MD, DOCX, JSON",
    "",
    "Embedding batch size recommendations:",
    "  - Small projects (< 1000 chunks): 10-50",
    "  - Medium projects (1000-10000 chunks): 50-100",
    "  - Large projects (> 10000 chunks): 100-200",
    "",
    "To check task status, use: GET /api/results/{task_id}",
    "",
    "The final result will be in the last task (usually 'pass_through')",
    "",
    "All tasks run asynchronously via Celery workers"
  ]
