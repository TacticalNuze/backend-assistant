  "field_descriptions": {
    "workflow_id": "Optional: Unique identifier for tracking this workflow execution",
    "client_id": "Required: Client/organization identifier (used to locate files in MinIO bucket)",
    "project_id": "Required: Project identifier within the client (used as prefix in MinIO: client_id/project_id/)",
    "language": "Required: Language code ('en', 'it', 'fr') - auto-injects domain_id and affects collection naming",
    "embedding_model": "Required: Embedding model name (e.g., 'text-embedding-3-large', 'text-embedding-ada-002')",
    "embedding_provider": "Required: Provider name ('azure_openai', 'openai', or other supported providers)",
    "embedding_batch_size": "Required: Number of chunks to process in each batch (recommended: 50-200)",
    "domain_id": "Optional: Domain identifier (auto-injected based on language if not provided)",
    "chunking_method": "Optional: Chunking method (e.g., 'semantic_chunker', 'token_chunker', 'sentence_chunker')"
  },
  
  "workflow_steps": {
    "description": "The preprocessing workflow executes these steps in order:",
    "steps": [
      {
        "step": "GetFiles",
        "description": "Retrieves all files from MinIO storage (bucket: client_id, prefix: project_id/)"
      },
      {
        "step": "parse_documents",
        "description": "Parses raw files into text content (supports PDF, TXT, MD, DOCX, JSON)"
      },
      {
        "step": "chunk_documents",
        "description": "Splits documents into smaller chunks for processing"
      },
      {
        "step": "generate_embeddings",
        "description": "Generates vector embeddings for each chunk (runs in parallel)"
      },
      {
        "step": "store_chunks_in_vector_db",
        "description": "Stores chunks with embeddings in ChromaDB (runs in parallel)"
      },
      {
        "step": "save_mapping_to_document_db",
        "description": "Saves chunk-to-file mappings in Elasticsearch (runs in parallel)"
      },
      {
        "step": "pass_through",
        "description": "Final step that passes results through unchanged"
      }
    ]
  },
  
  "curl_examples": {
